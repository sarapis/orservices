{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "arcanedev/log-viewer": "^10.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^3.0",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.5",
        "itsjavi/bootstrap-colorpicker": "^3.2",
        "ixudra/curl": "^6.19",
        "laravel/framework": "^10.0",
        "laravel/legacy-factories": "^1.3",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.0",
        "laravelcollective/html": "^6.1",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "owen-it/laravel-auditing": "^13.0",
        "sendgrid/sendgrid": "^7.6",
        "spatie/geocoder": "^3.8",
        "stevebauman/location": "^7.0.0",
        "symfony/http-client": "^6.4",
        "symfony/mailgun-mailer": "^6.4",
        "symfony/postmark-mailer": "^6.4",
        "usmanhalalit/laracsv": "^2.0",
        "yajra/laravel-datatables-buttons": "^10.0",
        "yajra/laravel-datatables-oracle": "^10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^9.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.30"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
        ],
        "files": [
            "app/Functions/Airtable.php",
            "app/Functions/Request.php",
            "app/Functions/Response.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
